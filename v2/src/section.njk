{% from "icon.njk" import icon with context %}
{% from "tile.njk" import tile with context %}
{% set items = cards | inSection(section.id) %}
<header class="subhead">
  <div class="subhead-inner">
    <div class="subhead-left">
      <button type="button" data-back aria-label="Back">{{ icon("arrow-left", "") }}</button>
      <a class="brand" href="{{ "/" | url }}">{{ icon("book-open", "icon-brand") }} Knowledge</a>
    </div>
  </div>
</header>
<section class="page-hero">
  <div>
    <p class="quiet">V2</p>
    <h1>{{ section.name }}</h1>
    <p class="lede">{{ section.summary }}</p>
    {% if section.id == "diary" %}
      <p class="quiet">The diary, the memory stack, and the FTS5 export live in <code>v2/memory</code>. This page lists diary cards when that pack adds them.</p>
    {% endif %}
    {% if section.id == "shards" %}
      <p class="quiet">These packs sit on top of the Base World Core Pack. A device keeps the core. It loads a shard when a question falls outside it. The format is <code>galion-shard-manifest/1</code>. {{ shardPack.shards | length }} shards are named. {{ shardPack.cards | length }} cards are seeded.</p>
    {% endif %}
  </div>
</section>
<section class="block">
  {% if section.id == "shards" %}
    <div class="tile-grid">
      {% for shard in shardPack.shards %}
        <a class="tile" href="{{ ("/shards/" + shard.id + "/") | url }}">
          <div class="tile-top">
            <span class="pill">{{ shard.priority }}</span>
            <span class="status status-other">{{ shard.status }}</span>
          </div>
          <h2>{{ shard.title }}</h2>
          <p>{{ shard.scope }}</p>
          <div class="tile-meta">
            <span>{{ shard.card_count }} card{% if shard.card_count != 1 %}s{% endif %}</span>
            <span class="tile-more">{{ icon("arrow-right", "icon-xs") }}</span>
          </div>
        </a>
      {% endfor %}
    </div>
  {% else %}
  <div class="cat-grid">
    {% for category in allCategories %}
      {% if category.section == section.id %}
        <a class="cat-card" href="{{ ("/category/" + category.id + "/") | url }}">
          <span style="color: {{ category.color }}">{{ icon(category.icon, "icon-lg") }}</span>
          <span>{{ category.name }}</span>
        </a>
      {% endif %}
    {% endfor %}
  </div>
  {% if items | length == 0 %}
    <p class="empty">No cards in this section yet.</p>
  {% else %}
    <div class="tile-grid">
      {% for card in items %}
        {{ tile(card) }}
      {% endfor %}
    </div>
  {% endif %}
  {% endif %}
</section>
