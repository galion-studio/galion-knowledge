{% from "icon.njk" import icon with context %}
<header class="nav">
  <div class="nav-inner">
    <a class="brand" href="{{ "/" | url }}">
      {{ icon("book-open", "icon-brand") }}
      <span>Galion <span class="accent">Knowledge</span></span>
      <span class="v2">V2</span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a href="{{ "/search/" | url }}">Explore</a>
      <a href="{{ "/principles/" | url }}">Principles</a>
      <a href="{{ "/category/science/" | url }}">Science</a>
      <a href="{{ "/section/world/" | url }}">World</a>
      <div class="nav-drop" data-nav-drop>
        <a href="{{ "/section/horbm/" | url }}">HORBM</a>
        <button class="nav-drop-toggle" type="button" data-nav-drop-toggle aria-expanded="false" aria-controls="nav-drop-horbm" aria-label="More HORBM pages">
          <svg class="nav-caret" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M3.5 6 8 10.5 12.5 6"/>
          </svg>
        </button>
        <div class="nav-drop-menu" id="nav-drop-horbm">
          <a href="{{ "/section/horbm/" | url }}">HORBM</a>
          <a href="{{ "/horbm/" | url }}">Layers diagram</a>
          <a href="{{ "/horbm/interactive/" | url }}">Interactive diagram</a>
        </div>
      </div>
      <a href="{{ "/section/diary/" | url }}">Diary</a>
      <a href="{{ "/section/shards/" | url }}">Shards</a>
      <a class="nav-cta" href="{{ "/search/" | url }}">Get Started</a>
    </nav>
    <button class="nav-open" type="button" data-nav-open aria-label="Open menu">
      {{ icon("menu", "") }}
    </button>
  </div>
</header>
<div class="nav-backdrop" data-nav-backdrop hidden></div>
<aside class="nav-panel" data-nav-panel hidden aria-label="Menu">
  <div class="nav-panel-head">
    <span class="brand">{{ icon("book-open", "icon-brand") }} Knowledge</span>
    <button type="button" data-nav-close aria-label="Close menu">{{ icon("x", "") }}</button>
  </div>
  <div class="nav-panel-links">
    <a href="{{ "/" | url }}">{{ icon("home", "") }} Home</a>
    <a href="{{ "/principles/" | url }}">{{ icon("shield", "") }} How this knowledge is built</a>
    <a href="{{ "/search/" | url }}">{{ icon("search", "") }} Search</a>
    <a href="{{ "/section/world/" | url }}">World Knowledge</a>
    <a href="{{ "/section/horbm/" | url }}">HORBM Internal</a>
    <a class="nav-sub" href="{{ "/horbm/" | url }}">Layers diagram</a>
    <a class="nav-sub" href="{{ "/horbm/interactive/" | url }}">Interactive diagram</a>
    <a href="{{ "/section/diary/" | url }}">Diary and Memory</a>
    <a href="{{ "/section/shards/" | url }}">Add-on shards</a>
  </div>
  <p class="nav-label">Categories</p>
  <div class="nav-panel-links">
    {% for category in catalog.categories %}
      {% if category.section == "world" %}
        <a href="{{ ("/category/" + category.id + "/") | url }}">
          <span class="icon-slot" style="color: {{ category.color }}">{{ icon(category.icon, "") }}</span>
          {{ category.name }}
        </a>
      {% endif %}
    {% endfor %}
  </div>
  <p class="nav-panel-foot">Galion Knowledge V2</p>
</aside>
