<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or "Galion Knowledge" }} | Galion Knowledge</title>
  <meta name="description" content="{{ description or "Galion Knowledge V2. The Base World Knowledge Pack for HORBM and Galion Research." }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  {# In the page, not the cached stylesheet: a stale site.css must not leave the menu in the bar or the caret as a native button. #}
  <style>
    .nav-drop { position: relative; display: inline-flex; align-items: center; }
    .nav-drop-toggle {
      appearance: none; -webkit-appearance: none; background: transparent;
      border: 0; box-shadow: none; margin: 0; padding: 0.15rem; color: inherit; line-height: 0;
    }
    .nav-caret { width: 0.875rem; height: 0.875rem; display: block; }
    .nav-drop-menu {
      display: none; position: absolute; z-index: 30; top: calc(100% + 0.35rem); left: 0;
      min-width: 12rem; margin: 0; padding: 0.35rem; background: #0a0f1c; color: #9ca3af;
      border: 1px solid #1f2937; border-radius: 0.75rem; box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
    }
    .nav-drop-menu a { display: block; padding: 0.5rem 0.75rem; border-radius: 0.5rem; white-space: nowrap; color: #9ca3af; text-decoration: none; }
    .nav-drop-menu a:first-child { color: #fff; font-weight: 500; }
    .nav-drop-menu a:hover, .nav-drop-menu a:focus-visible { background: #1f2937; color: #fff; }
    .nav-drop:hover > .nav-drop-menu,
    .nav-drop:focus-within > .nav-drop-menu,
    .nav-drop.is-open > .nav-drop-menu { display: block; }
    .nav-drop.is-shut > .nav-drop-menu,
    .nav-drop.is-shut:hover > .nav-drop-menu,
    .nav-drop.is-shut:focus-within > .nav-drop-menu { display: none; }
  </style>
  <link rel="stylesheet" href="{{ "/assets/site.css" | url }}?v={{ assetVersion }}">
  <link rel="icon" href="{{ "/assets/favicon.svg" | url }}">
  {% if card and card.id %}
  <link rel="canonical" href="{{ ("/article/" + card.id + "/") | url }}">
  {% endif %}
</head>
<body data-root="{{ "/" | url }}">
  <div class="bg-glow" aria-hidden="true"></div>
  {% include "nav.njk" %}
  {{ content | safe }}
  {% include "footer.njk" %}
  <script src="{{ "/assets/app.js" | url }}?v={{ assetVersion }}" defer></script>
  {% if globe %}
  <script type="importmap">
  {
    "imports": {
      "three": "{{ "/assets/vendor/three.module.min.js" | url }}?v={{ assetVersion }}",
      "three/addons/": "{{ "/assets/vendor/addons/" | url }}"
    }
  }
  </script>
  <script type="module" src="{{ "/assets/globe.js" | url }}?v={{ assetVersion }}"></script>
  {% endif %}
</body>
</html>
